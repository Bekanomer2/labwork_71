@model List<labwork_71.Models.Cafe>

@{
    ViewData["Title"] = "Заведения";
}

<div class="container pt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Заведения</h2>

        @if (User.IsInRole("admin"))
        {
            <a asp-controller="Cafe" asp-action="Create" class="btn btn-primary">
                Добавить заведение
            </a>
        }
    </div>

    @if (Model.Count == 0)
    {
        <p>Заведений пока нет.</p>
    }
    else
    {
        <div class="row g-4">
            @foreach (var cafe in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">

                        <a asp-controller="Cafe" asp-action="Details" asp-route-id="@cafe.Id" class="text-decoration-none text-dark">
                            <div class="text-center pt-3">
                                <img src="@cafe.AvatarUrl" alt="@cafe.Name" style="width: 140px; height: 140px; object-fit: cover; border-radius: 8px;" />
                            </div>

                            <div class="card-body">
                                <h5 class="card-title text-primary">@cafe.Name</h5>
                                <p class="card-text">@cafe.Description</p>
                            </div>
                        </a>

                        @if (User.IsInRole("admin"))
                        {
                            <div class="card-footer bg-white border-0">
                                <form asp-controller="Cafe" asp-action="Delete" asp-route-id="@cafe.Id" method="post" onsubmit="return confirm('Вы действительно хотите удалить это заведение?');">
                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="btn btn-danger btn-sm">
                                        Удалить
                                    </button>
                                </form>
                            </div>
                        }

                    </div>
                </div>
            }
        </div>
    }

</div>