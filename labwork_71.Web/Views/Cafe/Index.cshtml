@model List<labwork_71.Models.Cafe>

@{
    ViewData["Title"] = "Заведения";
}

<div class="container mt-4">
    <h2 class="mb-3">Заведения</h2>

    @if (User.IsInRole("admin"))
    {
        <a asp-controller="Cafe" asp-action="Create" class="btn btn-primary mb-4">
            Добавить заведение
        </a>
    }

    @if (Model.Count == 0)
    {
        <p>Заведений пока нет.</p>
    }
    else
    {
        @foreach (var cafe in Model)
        {
            <div class="card mb-3" style="max-width: 700px;">
                <div class="card-body">

                    <img src="@cafe.AvatarUrl"
                         alt="@cafe.Name"
                         style="width: 150px; height: 150px; object-fit: cover;" />

                    <h4 class="mt-3">@cafe.Name</h4>

                    <p>@cafe.Description</p>

                    <form asp-controller="Cafe" asp-action="Delete" asp-route-id="@cafe.Id" method="post">
                        @Html.AntiForgeryToken()

                        <button type="submit" class="btn btn-danger">
                            Удалить
                        </button>
                    </form>

                </div>
            </div>
        }
    }
</div>