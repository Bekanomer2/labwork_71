@model labwork_71.Models.Cafe

@{
    ViewData["Title"] = Model.Name;
}

<div class="container pt-4">

    <div class="mb-4">
        <img src="@Model.AvatarUrl" alt="@Model.Name" style="width: 200px; height: 200px; object-fit: cover;" />

        <h2 class="mt-3">@Model.Name</h2>

        <p>@Model.Description</p>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Блюда</h3>

        @if (User.IsInRole("admin"))
        {
            <a asp-controller="Dish" asp-action="Create" asp-route-cafeId="@Model.Id" class="btn btn-primary">
                Добавить блюдо
            </a>
        }
    </div>

    @if (Model.Dishes == null || Model.Dishes.Count == 0)
    {
        <p>Блюд пока нет.</p>
    }
    else
    {
        <div class="row">
            @foreach (var dish in Model.Dishes)
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5>@dish.Name</h5>
                            <p>@dish.Description</p>
                            <strong>@dish.Price</strong>

                            @if (User.IsInRole("admin"))
                            {
                                <form asp-controller="Dish" asp-action="Delete" asp-route-id="@dish.Id" asp-route-cafeId="@Model.Id" method="post" class="mt-3" onsubmit="return confirm('Вы действительно хотите удалить это блюдо?');">
                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="btn btn-danger btn-sm">Удалить</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>