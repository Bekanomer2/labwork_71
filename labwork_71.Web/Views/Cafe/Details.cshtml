@model labwork_71.Models.Cafe

@{
    ViewData["Title"] = Model.Name;
}

<div class="container pt-4">

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <div class="d-flex flex-column flex-md-row align-items-md-center gap-4">
            <img src="@Model.AvatarUrl" alt="@Model.Name" class="rounded-3 shadow-sm" style="width: 180px; height: 180px; object-fit: cover;" onerror="this.src='/default.jpg';" />
            <div>
                <h2 class="fw-bold mb-2">@Model.Name</h2>
                <p class="text-muted mb-0">@Model.Description</p>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">Меню заведения</h3>

        @if (User.IsInRole("admin"))
        {
            <a asp-controller="Dish" asp-action="Create" asp-route-cafeId="@Model.Id" class="btn btn-primary rounded-pill px-3">
                <i class="bi bi-plus-circle me-1"></i>Добавить блюдо
            </a>
        }
    </div>

    @if (Model.Dishes == null || Model.Dishes.Count == 0)
    {
        <div class="alert alert-light border text-center py-4 rounded-3 text-muted">
            <i class="bi bi-egg-fried fs-3 d-block mb-2"></i>
            Блюд в этом заведении пока нет.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var dish in Model.Dishes)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4">
                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="fw-bold mb-2">@dish.Name</h5>
                            <p class="text-muted small flex-grow-1">@dish.Description</p>
                            
                            <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-2">
                                <span class="fs-5 fw-bold text-primary">@dish.Price сом</span>
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 add-to-cart shadow-none"
                                        data-dish-id="@dish.Id">
                                    <i class="bi bi-cart-plus me-1"></i>В корзину
                                </button>
                            </div>

                            @if (User.IsInRole("admin"))
                            {
                                <form asp-controller="Dish" asp-action="Delete" asp-route-id="@dish.Id" asp-route-cafeId="@Model.Id"
                                      method="post" class="mt-2 text-end" onsubmit="return confirm('Вы действительно хотите удалить это блюдо?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-link text-danger btn-sm p-0 text-decoration-none">
                                        <i class="bi bi-trash3 me-1"></i>Удалить блюдо
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>
