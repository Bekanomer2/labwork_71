@model labwork_71.ViewModels.CartViewModel

@{
    ViewData["Title"] = "Корзина заказов";
}

<div class="container py-4">
    <div class="d-flex align-items-center mb-4">
        <h2 class="fw-bold mb-0">
            <i class="bi bi-cart3 text-primary me-2"></i>Ваш заказ
        </h2>
    </div>

    @if (Model.Items == null || Model.Items.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5">
            <div class="card-body">
                <i class="bi bi-cart-x fs-1 text-secondary opacity-50 mb-3 d-block"></i>
                <h4 class="fw-bold">Корзина пуста</h4>
                <p class="text-muted mb-4">Перейдите к списку заведений и выберите понравившиеся блюда</p>
                <a asp-controller="Cafe" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-shop me-1"></i>К заведениям
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-4">Блюдо</th>
                                    <th scope="col">Цена</th>
                                    <th scope="col" class="text-center">Количество</th>
                                    <th scope="col">Итого</th>
                                    <th scope="col" class="pe-4"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <span class="fw-semibold">@item.Name</span>
                                        </td>
                                        <td>@item.Price сом</td>
                                        <td class="text-center">
                                            <div class="d-inline-flex align-items-center border rounded-pill px-2 py-1">
                                                <button type="button" class="btn btn-sm btn-link text-dark p-0 remove-from-cart"
                                                        data-dish-id="@item.DishId">
                                                    <i class="bi bi-dash"></i>
                                                </button>
                                                <span class="fw-semibold px-2">@item.Quantity</span>
                                                <button type="button" class="btn btn-sm btn-link text-primary p-0 add-to-cart"
                                                        data-dish-id="@item.DishId">
                                                    <i class="bi bi-plus"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td>
                                            <strong class="text-primary">@item.TotalPrice сом</strong>
                                        </td>
                                        <td class="pe-4 text-end">
                                            <button type="button" class="btn btn-link text-danger p-0 remove-from-cart"
                                                    data-dish-id="@item.DishId" title="Удалить">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <h5 class="fw-bold mb-3">Детали заказа</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Количество позиций:</span>
                        <span class="fw-semibold">@Model.Items.Sum(i => i.Quantity)</span>
                    </div>
                    <hr/>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fs-5 fw-bold">Всего к оплате:</span>
                        <span class="fs-4 fw-bold text-primary">@Model.TotalPrice сом</span>
                    </div>

                    <button type="button" class="btn btn-primary w-100 rounded-pill py-2 fw-semibold shadow-sm"
                            onclick="alert('Заказ успешно оформлен! Спасибо за покупку.');">
                        <i class="bi bi-check-circle me-1"></i>Подтвердить заказ
                    </button>
                </div>
            </div>
        </div>
    }
</div>
