@model List<labwork_71.Models.User>

@{
    ViewData["Title"] = "Пользователи";

    Dictionary<int, string> userRoles = ViewBag.UserRoles as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="container pt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Пользователи</h2>

        <a asp-controller="AdminUsers" asp-action="Create" class="btn btn-primary">
            Добавить пользователя
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <p>Пользователей пока нет.</p>
    }
    else
    {
        <table class="table table-bordered align-middle">
            <thead>
            <tr>
                <th>Id</th>
                <th>Имя пользователя</th>
                <th>Email</th>
                <th>Телефон</th>
                <th>Роль</th>
                <th>Действия</th>
            </tr>
            </thead>

            <tbody>
            @foreach (var user in Model)
            {
                string currentRole = userRoles.ContainsKey(user.Id) ? userRoles[user.Id] : "user";

                <tr>
                    <td>@user.Id</td>
                    <td>@user.UserName</td>
                    <td>@user.Email</td>
                    <td>@user.PhoneNumber</td>

                    <td>
                        @if (user.UserName == "admin")
                        {
                            <span class="badge bg-primary">
                                admin
                            </span>
                        }
                        else
                        {
                            <form asp-controller="AdminUsers" asp-action="ChangeRole" asp-route-id="@user.Id" method="post" class="d-flex gap-2">

                                @Html.AntiForgeryToken()

                                <select name="role" class="form-select form-select-sm">

                                    @if (currentRole == "user")
                                    {
                                        <option value="user" selected>user</option>
                                        <option value="admin">admin</option>
                                    }
                                    else
                                    {
                                        <option value="user">user</option>
                                        <option value="admin" selected>admin</option>
                                    }

                                </select>

                                <button type="submit" class="btn btn-outline-primary btn-sm">
                                    Сохранить
                                </button>
                            </form>
                        }
                    </td>

                    <td>
                        @if (user.UserName != "admin")
                        {
                            <form asp-controller="AdminUsers" asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Вы действительно хотите удалить этого пользователя?');">

                                @Html.AntiForgeryToken()

                                <button type="submit" class="btn btn-danger btn-sm">
                                    Удалить
                                </button>
                            </form>
                        }
                    </td>

                </tr>
            }
            </tbody>
        </table>
    }

</div>