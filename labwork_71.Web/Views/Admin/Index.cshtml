@model labwork_71.Models.User
@{
    ViewData["Title"] = "Панель администратора";
}

<div class="container py-5">

    <div class="row justify-content-center mb-5">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card rounded-4 shadow border-0">
                <div class="card-body p-4">

                    <div class="d-flex align-items-center gap-4 mb-4">
                        @if (Model != null && !string.IsNullOrEmpty(Model.AvatarUrl))
                        {
                            <img src="@Model.AvatarUrl"
                                 alt="Аватар"
                                 class="rounded-circle border"
                                 style="width:100px;height:100px;object-fit:cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-danger d-flex align-items-center justify-content-center"
                                 style="width:100px;height:100px;">
                                <i class="bi bi-person-fill text-white fs-1"></i>
                            </div>
                        }
                        <div>
                            <h4 class="fw-bold mb-1">@(Model?.UserName ?? "Администратор")</h4>
                            <span class="badge bg-danger">Администратор</span>
                        </div>
                    </div>

                    <hr />

                    <ul class="list-group list-group-flush">
                        <li class="list-group-item px-0 d-flex align-items-center gap-2">
                            <i class="bi bi-envelope text-danger"></i>
                            <div>
                                <small class="text-muted d-block">Email</small>
                                <span>@(Model?.Email ?? "—")</span>
                            </div>
                        </li>
                    </ul>

                </div>
            </div>
        </div>
    </div>

    <h5 class="fw-bold mb-3">
        <i class="bi bi-grid me-2 text-danger"></i>Управление
    </h5>

    <div class="row g-4">

        <div class="col-12 col-md-4">
            <div class="card h-100 rounded-4 shadow-sm border-0">
                <div class="card-body d-flex flex-column">
                    <div class="mb-3">
                        <span class="p-3 bg-danger bg-opacity-10 rounded-3 d-inline-block">
                            <i class="bi bi-shop text-danger fs-4"></i>
                        </span>
                    </div>
                    <h5 class="card-title fw-semibold">Заведения</h5>
                    <p class="card-text text-muted small flex-grow-1">Добавляйте, редактируйте и удаляйте заведения.</p>
                    <a asp-controller="Cafe" asp-action="Index" class="btn btn-outline-danger rounded-3 mt-2">
                        Перейти
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card h-100 rounded-4 shadow-sm border-0">
                <div class="card-body d-flex flex-column">
                    <div class="mb-3">
                        <span class="p-3 bg-primary bg-opacity-10 rounded-3 d-inline-block">
                            <i class="bi bi-people text-primary fs-4"></i>
                        </span>
                    </div>
                    <h5 class="card-title fw-semibold">Пользователи</h5>
                    <p class="card-text text-muted small flex-grow-1">Управляйте пользователями и их ролями.</p>
                    <a asp-controller="AdminUsers" asp-action="Index" class="btn btn-outline-primary rounded-3 mt-2">
                        Перейти
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card h-100 rounded-4 shadow-sm border-0">
                <div class="card-body d-flex flex-column">
                    <div class="mb-3">
                        <span class="p-3 bg-success bg-opacity-10 rounded-3 d-inline-block">
                            <i class="bi bi-egg-fried text-success fs-4"></i>
                        </span>
                    </div>
                    <h5 class="card-title fw-semibold">Блюда</h5>
                    <p class="card-text text-muted small flex-grow-1">Просматривайте и редактируйте блюда заведений.</p>
                    <a asp-controller="Dish" asp-action="Index" class="btn btn-outline-success rounded-3 mt-2">
                        Перейти
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>
