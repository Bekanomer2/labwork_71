@model List<labwork_71.Models.Order>
@{
    ViewData["Title"] = "Все заказы";
}

<div class="container py-5">

    <h4 class="fw-bold mb-4">
        <i class="bi bi-list-check me-2 text-danger"></i>Все заказы
    </h4>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox text-muted" style="font-size:3rem;"></i>
            <p class="text-muted mt-3 fs-5">Заказов пока нет</p>
        </div>
    }
    else
    {
        <div class="card rounded-4 shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Дата</th>
                            <th>Получатель</th>
                            <th>Телефон</th>
                            <th>Адрес</th>
                            <th>Состав заказа</th>
                            <th>Сумма</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@order.Id</td>
                                <td class="text-muted small">@order.OrderDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@order.RecipientName</td>
                                <td>@order.RecipientPhone</td>
                                <td>@order.DeliveryAddress</td>
                                <td>
                                    @if (order.OrderItems != null && order.OrderItems.Any())
                                    {
                                        <ul class="list-unstyled mb-0 small">
                                            @foreach (var item in order.OrderItems)
                                            {
                                                <li>
                                                    <span class="badge bg-secondary-subtle text-secondary me-1">@item.Quantity шт.</span>
                                                    @(item.Dish?.Name ?? $"Блюдо #{item.ProductId}")
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="fw-bold text-nowrap">
                                    @if (order.OrderItems != null && order.OrderItems.Any(i => i.Dish != null))
                                    {
                                        <span>@order.OrderItems.Sum(i => i.Quantity * (i.Dish?.Price ?? 0)) сом</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>
