<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - FoodOrders</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/labwork_71.Web.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
<header>
    <nav class="navbar navbar-expand-md navbar-light bg-white border-bottom shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold text-primary d-flex align-items-center" asp-controller="Main" asp-action="Index">
                <i class="bi bi-egg-fried fs-4 me-2"></i>FoodOrders
            </a>
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                    aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-md-0">
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium d-flex align-items-center" asp-controller="Main" asp-action="Index">
                            <i class="bi bi-shop me-1 text-secondary"></i>Все заведения
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav align-items-md-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item me-md-2 mb-2 mb-md-0">
                            <a class="nav-link text-dark fw-medium d-flex align-items-center" asp-controller="User" asp-action="Index">
                                <i class="bi bi-person-circle fs-5 me-1 text-primary"></i>
                                <span>Личный кабинет</span>
                                <span class="badge bg-primary-subtle text-primary ms-1 small">@User.Identity.Name</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="LogOff" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 d-flex align-items-center">
                                    <i class="bi bi-box-arrow-right me-1"></i>Выйти
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item me-md-2 mb-2 mb-md-0">
                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3 w-100" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Войти
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary btn-sm rounded-pill px-3 w-100" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus me-1"></i>Регистрация
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

<main role="main" class="flex-grow-1 d-flex flex-column justify-content-center">
    @RenderBody()
</main>

<footer class="border-top py-3 bg-white text-muted mt-auto">
    <div class="container text-center small">
        &copy; 2026 - FoodOrders. Приложение для заказа доставки еды.
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
