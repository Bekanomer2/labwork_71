@model labwork_71.ViewModels.CartViewModel

<div class="cart-sidebar">
    <h4 class="cart-title">🛒 Моя корзина</h4>
    @if (Model.Items.Count == 0)
    {
        <div class="empty-cart"></div>
        <span>🛍️</span>
        <p>Корзина пока пуста</p>
        <small>Выберите что-нибудь вкусное</small>
    }
    else
    {
        foreach (var item in Model.Items)
        {
            <div class="cart-item">
                <div class="cart-item-info">
                    <h5>@item.Name</h5>
                    <span>@item.Price сом × @item.Quantity</span>
                </div>
                <div class="cart-item-bottom">
                    <strong>@item.TotalPrice сом</strong>
                    <button type="button"
                            class="remove-from-cart"
                            data-dish-id="@item.DishId">
                        Удалить
                    </button>
                    <input type="hidden" value="@item.DishId" />
                </div>
            </div>
        }

        <div class="cart-total">
            <span>Итого:</span>
            <strong>@Model.TotalPrice сом</strong>
        </div>
    }

</div>
